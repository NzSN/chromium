import("//build/config/ui.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")

grit("my_app_resources_grit") {
  source = "resources/my_app_resources.grd"
  outputs = [
    "grit/my_app_resources.h",
    "my_app_resources.pak",
  ]
  output_dir = "$root_gen_dir/my_app"
}

repack("pak") {
  sources = [
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/my_app/my_app_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
    "$root_gen_dir/ui/webui/resources/webui_resources.pak",
  ]

  deps = [
    ":my_app_resources_grit",
    "//content:content_resources",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//ui/resources",
    "//ui/strings",
    "//ui/webui/resources",
  ]

  if (toolkit_views) {
    deps += [ "//ui/views/resources" ]
    sources +=
        [ "$root_gen_dir/ui/views/resources/views_resources_100_percent.pak" ]
  }

  output = "$root_out_dir/my_app.pak"
}

static_library("my_app_lib") {
  sources = [
    "browser/app_browser_client.cc",
    "browser/app_browser_client.h",
    "browser/app_browser_context.cc",
    "browser/app_browser_context.h",
    "browser/app_browser_main_parts.cc",
    "browser/app_browser_main_parts.h",
    "browser/app_url_loader_factory.cc",
    "browser/app_url_loader_factory.h",
    "browser/app_window.cc",
    "browser/app_window.h",
    "browser/ipc/native_api_impl.cc",
    "browser/ipc/native_api_impl.h",
    "browser/native/clipboard_bridge.cc",
    "browser/native/clipboard_bridge.h",
    "browser/native/file_dialog_bridge.cc",
    "browser/native/file_dialog_bridge.h",
    "browser/native/menu_manager.cc",
    "browser/native/menu_manager.h",
    "browser/native/notification_manager.cc",
    "browser/native/notification_manager.h",
    "browser/native/system_tray.cc",
    "browser/native/system_tray.h",
    "common/app_content_client.cc",
    "common/app_content_client.h",
    "common/app_switches.cc",
    "common/app_switches.h",
    "renderer/app_renderer_client.cc",
    "renderer/app_renderer_client.h",
  ]

  include_dirs = [ "$root_gen_dir/my_app" ]

  deps = [
    ":my_app_resources_grit",
    "//base",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//content/public/renderer",
    "//mojo/public/cpp/bindings",
    "//my_app/common/mojom",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/zlib/google:compression_utils",
    "//ui/base",
    "//ui/base/clipboard",
    "//ui/display",
    "//ui/gfx",
    "//ui/menus",
    "//ui/message_center",
    "//ui/shell_dialogs",
    "//ui/views",
    "//ui/views/controls/webview",
    "//ui/wm",
    "//url",
  ]

  if (use_aura) {
    deps += [
      "//ui/aura",
      "//ui/wm/public",
    ]
  }
}

static_library("my_app_app") {
  sources = [
    "app/app_crash_reporter_client.cc",
    "app/app_crash_reporter_client.h",
    "app/main_delegate.cc",
    "app/main_delegate.h",
  ]

  deps = [
    ":my_app_lib",
    "//base",
    "//components/crash/core/app",
    "//content/public/app",
    "//content/public/common",
    "//ui/base",
  ]
}

executable("my_app") {
  sources = [ "app/main.cc" ]

  deps = [
    ":my_app_app",
    "//base",
    "//content/public/app",
  ]

  data_deps = [
    ":pak",
    "//tools/v8_context_snapshot",
  ]

  if (is_win) {
    configs += [ "//build/config/win:windowed" ]
    deps += [
      "//build/win:default_exe_manifest",
      "//content:sandbox_helper_win",
      "//sandbox/win:sandbox",
    ]
  }

  if (is_mac) {
    deps += [ "//sandbox/mac:seatbelt" ]
  }
}
